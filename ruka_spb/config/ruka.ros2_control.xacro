<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ruka_controlled_joint" params="joint_name velocity_command">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <xacro:if value="${velocity_command}">
        <command_interface name="velocity"/>
      </xacro:if>
      <state_interface name="position">
        <param name="initial_value">${initial_positions[joint_name]}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro
    name="ruka_ros2_control"
    params="name initial_positions_file use_mock_hardware:=true end_effector_type:=mechanical can_interface:=vcan1.0 node_id:=100 queue_length:=1000 feedback_timeout:=0.25 heartbeat_timeout:=2.5 activation_timeout:=5.0 startup_grace:=1.0 require_all_joints_on_activate:=true">
    <xacro:property
      name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"
    />
    <xacro:property
      name="use_mock_hardware_bool"
      value="${str(use_mock_hardware).lower() in ['true', '1', 'yes']}"/>
    <xacro:property
      name="use_mechanical_gripper"
      value="${str(end_effector_type).lower() == 'mechanical'}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware_bool}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware_bool}">
          <plugin>ruka_spb/Ruka2System</plugin>
          <param name="can_interface">${can_interface}</param>
          <param name="node_id">${node_id}</param>
          <param name="queue_length">${queue_length}</param>
          <param name="feedback_timeout">${feedback_timeout}</param>
          <param name="heartbeat_timeout">${heartbeat_timeout}</param>
          <param name="activation_timeout">${activation_timeout}</param>
          <param name="startup_grace">${startup_grace}</param>
          <param name="maximum_servo_velocity">1.0</param>
          <param name="servo_acceleration">1.0</param>
          <param name="require_all_joints_on_activate">${require_all_joints_on_activate}</param>
        </xacro:unless>
      </hardware>

      <xacro:ruka_controlled_joint joint_name="joint_1" velocity_command="true"/>
      <xacro:ruka_controlled_joint joint_name="joint_2" velocity_command="true"/>
      <xacro:ruka_controlled_joint joint_name="joint_3" velocity_command="true"/>
      <xacro:ruka_controlled_joint joint_name="joint_4" velocity_command="true"/>
      <xacro:ruka_controlled_joint joint_name="joint_5" velocity_command="true"/>
      <xacro:ruka_controlled_joint joint_name="joint_6" velocity_command="true"/>
    </ros2_control>

    <xacro:if value="${use_mechanical_gripper}">
      <ros2_control name="${name}Gripper" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </hardware>
        <xacro:ruka_controlled_joint joint_name="link_hand_cyl__first_fin" velocity_command="false"/>
        <joint name="link_hand_cyl__second_fin">
          <state_interface name="position">
            <param name="initial_value">${initial_positions['link_hand_cyl__second_fin']}</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
