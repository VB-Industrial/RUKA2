    <joint name="joint_5" type="revolute">
        <axis xyz="0 0 1"/>

        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.313300981" soft_upper_limit="${joint_5_soft_upper_limit}" />

        <limit effort="1000.0" lower="-2.39" upper="${joint_5_upper_limit}" velocity="1.0"/>
        <origin rpy="-1.57 0 0" xyz="0 0 0.264"/>
        <parent link="link_04"/>
        <child link="link_05"/>
    </joint>

    <link name="link_05">
        <!-- Light body: 74 mm wide, 82 mm long and 100 mm high.
             The J5 axis is 30 mm above its lower face. -->
        <visual>
            <origin rpy="0 1.57 0" xyz="0.020 0 0" />
            <geometry>
                <box size="0.074 0.082 0.100" />
            </geometry>
            <material name="white"/>
        </visual>

        <collision>
            <origin rpy="0 1.57 0" xyz="0.020 0 0" />
            <geometry>
                <box size="0.074 0.082 0.100" />
            </geometry>
        </collision>
    </link>

    <joint name="link_05__link_05_red" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="link_05"/>
        <child link="link_05_red"/>
    </joint>

    <link name="link_05_red">
        <!-- Front cover towards the gripper: 20 mm thick. -->
        <visual>
            <origin rpy="0 1.57 0" xyz="0.020 -0.051 0" />
            <geometry>
                <box size="0.074 0.020 0.100" />
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin rpy="0 1.57 0" xyz="0.020 -0.051 0" />
            <geometry>
                <box size="0.074 0.020 0.100" />
            </geometry>
        </collision>

        <!-- Rear cover: 27 mm thick. -->
        <visual>
            <origin rpy="0 1.57 0" xyz="0.020 0.0545 0" />
            <geometry>
                <box size="0.074 0.027 0.100" />
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <origin rpy="0 1.57 0" xyz="0.020 0.0545 0" />
            <geometry>
                <box size="0.074 0.027 0.100" />
            </geometry>
        </collision>
    </link>

    <joint name="joint_6" type="revolute">
        <axis xyz="0 0 1"/>

        <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.743300981" soft_upper_limit="2.763300981" />

        <limit effort="1000.0" lower="-2.82" upper="2.84" velocity="1.0"/>
        <origin rpy="1.57 0 0" xyz="0 -0.086 0"/>
        <parent link="link_05"/>
        <child link="link_06"/>
    </joint>

    <link name="link_06">
        <!-- The distal face is the gripper mounting plane. -->
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.0125" />
            <geometry>
                <cylinder radius="0.018" length="0.025" />
            </geometry>
            <material name="white"/>
        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 -0.0125" />
            <geometry>
                <cylinder radius="0.018" length="0.025" />
            </geometry>
        </collision>
    </link>


    <joint name="link_06__link_hand_cyl" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="link_06"/>
        <child link="link_hand_cyl"/>
    </joint>

    <link name="link_hand_cyl">
        <xacro:if value="${show_mechanical_end_effector}">
            <inertial>
                <mass value="0.01"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <inertia
                    ixx="0.00001" ixy="0" ixz="0"
                    iyy="0.00001" iyz="0" izz="0.00001"
                />
            </inertial>
            <visual>
                <origin rpy="0 0 1.57" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/gripper4310.stl"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <origin rpy="0 0 1.57" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/gripper4310.stl"/>
                </geometry>
            </collision>
        </xacro:if>
        <xacro:if value="${show_electromagnetic_end_effector}">
            <visual name="electromagnetic_gripper_visual">
                <origin
                    rpy="0 0 -1.5707963268"
                    xyz="-0.02 -0.0150980395 -0.0162865356"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/mag-gripper.stl"/>
                </geometry>
                <material name="gray"/>
            </visual>
            <collision name="electromagnetic_gripper_collision">
                <origin
                    rpy="0 0 -1.5707963268"
                    xyz="-0.02 -0.0150980395 -0.0162865356"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/mag-gripper.stl"/>
                </geometry>
            </collision>
        </xacro:if>
    </link>

    <joint name="link_06__tool0" type="fixed">
        <origin rpy="0 ${tool0_pitch} 0" xyz="${tool0_x} 0 ${tool0_z}"/>
        <parent link="link_06"/>
        <child link="tool0"/>
    </joint>
    <link name="tool0"/>

    <joint
        name="link_hand_cyl__first_fin"
        type="${'prismatic' if show_mechanical_end_effector else 'fixed'}">
        <parent link="link_hand_cyl"/>
        <child link="first_fin"/>
        <origin rpy="1.57 0 3.14" xyz="0 0.005 0.0642"/>
        <xacro:if value="${show_mechanical_end_effector}">
            <axis xyz="0 0 1"/>
            <limit effort="15" lower="0.008" upper="0.025" velocity="0.012"/>
        </xacro:if>
    </joint>

    <link name="first_fin">
        <xacro:if value="${show_mechanical_end_effector}">
            <inertial>
                <mass value="0.01"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <inertia
                    ixx="0.00001" ixy="0" ixz="0"
                    iyy="0.00001" iyz="0" izz="0.00001"
                />
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/finger50mm-S.stl"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/finger50mm-S.stl"/>
                </geometry>
            </collision>
        </xacro:if>
    </link>

    <joint
        name="link_hand_cyl__second_fin"
        type="${'prismatic' if show_mechanical_end_effector else 'fixed'}">
        <parent link="link_hand_cyl"/>
        <child link="second_fin"/>
        <origin rpy="1.57 0 0" xyz="0 -0.005 0.0642"/>
        <xacro:if value="${show_mechanical_end_effector}">
            <axis xyz="0 0 1"/>
            <limit effort="15" lower="0.008" upper="0.025" velocity="0.012"/>
            <mimic joint="link_hand_cyl__first_fin" multiplier="1.0" offset="0.0"/>
        </xacro:if>
    </joint>

    <link name="second_fin">
        <xacro:if value="${show_mechanical_end_effector}">
            <inertial>
                <mass value="0.01"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <inertia
                    ixx="0.00001" ixy="0" ixz="0"
                    iyy="0.00001" iyz="0" izz="0.00001"
                />
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/finger50mm-S-1.stl"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://ruka_spb/config/mesh/finger50mm-S-1.stl"/>
                </geometry>
            </collision>
        </xacro:if>
    </link>

</robot>
