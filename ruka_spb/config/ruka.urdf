<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ruka">


    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>

    <material name="gray">
        <color rgba="0.45 0.45 0.45 1"/>
    </material>

    <link name="base_link">
        <visual>
          <origin rpy="0 0 0" xyz="0 0 0.025" />
          <geometry>
            <cylinder radius="0.09" length="0.05" />
          </geometry>

        <material name="white"/>
        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.025" />
          <geometry>
            <cylinder radius="0.09" length="0.05" />
          </geometry>
          </collision>

    </link>

    <joint name="joint_1" type="revolute">
        <axis xyz="0 0 1"/>

        <safety_controller k_position="100.0" k_velocity="200.0" soft_lower_limit="-2.833300981" soft_upper_limit="2.833300981" />

        <limit effort="1000.0" lower="-2.91" upper="2.91" velocity="0.7"/>
        <origin rpy="0 0 0" xyz="0 0 0.05"/>
        <parent link="base_link"/>
        <child link="link_01"/>

    </joint>

    <link name="link_01">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0.016" />
            <geometry>
                <cylinder radius="0.047" length="0.032" />
            </geometry>
            <material name="white"/>

        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0.016" />
            <geometry>
                <cylinder radius="0.047" length="0.032" />
            </geometry>
          </collision>

        <visual>
            <origin rpy="0 0 0" xyz="-0.0365 0 0.085" />
            <geometry>
