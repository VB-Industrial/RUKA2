<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>ruka_udp_fragmented</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
        <maxMessageSize>1400</maxMessageSize>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="ruka_udp_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>ruka_udp_fragmented</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
        <flow_controller_descriptor_list>
          <flow_controller_descriptor>
            <name>ruka_udp_flow</name>
            <scheduler>FIFO</scheduler>
            <max_bytes_per_period>1400</max_bytes_per_period>
            <period_ms>1</period_ms>
          </flow_controller_descriptor>
        </flow_controller_descriptor_list>
      </rtps>
    </participant>

    <data_writer profile_name="ruka_udp_writer" is_default_profile="true">
      <qos>
        <publishMode>
          <kind>ASYNCHRONOUS</kind>
          <flow_controller_name>ruka_udp_flow</flow_controller_name>
        </publishMode>
      </qos>
    </data_writer>
  </profiles>
</dds>
