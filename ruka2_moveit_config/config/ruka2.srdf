<?xml version="1.0" encoding="UTF-8"?>
<robot name="ruka2">
  <group name="ruka2_arm">
    <chain base_link="base_link" tip_link="link_06"/>
  </group>

  <group_state name="home" group="ruka2_arm">
    <joint name="joint_1" value="0.0"/>
    <joint name="joint_2" value="-0.7"/>
    <joint name="joint_3" value="1.2"/>
    <joint name="joint_4" value="0.0"/>
    <joint name="joint_5" value="-0.5"/>
    <joint name="joint_6" value="0.0"/>
  </group_state>

  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- Gripper geometry is retained, but its hardware integration is deferred. -->
  <passive_joint name="link_hand_cyl__first_fin"/>
  <passive_joint name="link_hand_cyl__second_fin"/>

  <disable_collisions link1="base_link" link2="link_01" reason="Adjacent"/>
  <disable_collisions link1="link_01" link2="link_01_red" reason="Adjacent"/>
  <disable_collisions link1="link_01" link2="link_02" reason="Adjacent"/>
  <disable_collisions link1="link_01_red" link2="link_02" reason="Adjacent"/>
  <disable_collisions link1="link_02" link2="link_02_red" reason="Adjacent"/>
  <disable_collisions link1="link_02" link2="link_03" reason="Adjacent"/>
  <disable_collisions link1="link_03" link2="link_03_red" reason="Adjacent"/>
  <disable_collisions link1="link_03" link2="link_04" reason="Adjacent"/>
  <disable_collisions link1="link_03_red" link2="link_04" reason="Adjacent"/>
  <disable_collisions link1="link_04" link2="link_04_red" reason="Adjacent"/>
  <disable_collisions link1="link_04" link2="link_05" reason="Adjacent"/>
  <disable_collisions link1="link_05" link2="link_05_red" reason="Adjacent"/>
  <disable_collisions link1="link_05" link2="link_06" reason="Adjacent"/>
  <disable_collisions link1="link_05_red" link2="link_06" reason="Adjacent"/>
  <disable_collisions link1="link_06" link2="link_hand_cyl" reason="Adjacent"/>
  <disable_collisions link1="link_hand_cyl" link2="first_fin" reason="Adjacent"/>
  <disable_collisions link1="link_hand_cyl" link2="second_fin" reason="Adjacent"/>
</robot>
